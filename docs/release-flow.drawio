        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="Release build (Actions, run on main)" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;fillColor=#f4f8fd;" vertex="1" parent="1">
          <mxGeometry x="510" y="100" width="400" height="560" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;guard&lt;/b&gt;&lt;br&gt;builds the revision you choose (default: main HEAD),&lt;br&gt;first attempt only, versions agree, changelog has x.y.z,&lt;br&gt;changes/ empty at that revision, nothing of x.y.z released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="530" y="130" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;check&lt;/b&gt;&lt;br&gt;Check passed&lt;br&gt;on main for&lt;br&gt;this commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="530" y="230" width="80" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;installers&lt;/b&gt;&lt;br&gt;macOS, Windows,&lt;br&gt;Linux, signed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="235" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;addon&lt;/b&gt;&lt;br&gt;signed&lt;br&gt;addon.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="720" y="235" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;image&lt;/b&gt;&lt;br&gt;ghcr.io, records&lt;br&gt;its digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="810" y="235" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="release-signing&lt;br&gt;(one approval)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;shape=rect;rounded=1;dashed=1;fillColor=none;verticalAlign=bottom;fontColor=#b46504;" vertex="1" parent="1">
          <mxGeometry x="612" y="225" width="196" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;feed&lt;/b&gt;&lt;br&gt;latest.json + addon.json + installers&lt;br&gt;&amp;#8594; artifact Goldbook-update-feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="530" y="360" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;verify&lt;/b&gt; (OVH helper, changes nothing)&lt;br&gt;verify: image pulls, service healthy&lt;br&gt;check-publish: feed would be accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="530" y="450" width="360" height="65" as="geometry" />
