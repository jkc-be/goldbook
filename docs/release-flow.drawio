  <diagram id="page-3" name="3. Example: stops and refusals">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Example: finishing a stopped promotion, and what the guards refuse" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="A. A promotion stops after the feed is published" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1640" height="270" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Promote run 1&lt;/b&gt; (build 4101)&lt;br&gt;server &amp;#10003;  publish &amp;#10003;&lt;br&gt;mirror &amp;#10007; (rejected or failed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;guard of run 2 reads every output&lt;/b&gt;&lt;br&gt;client feed: matches 4101&lt;br&gt;addon feed: matches 4101&lt;br&gt;mirror: absent&lt;br&gt;addon release: absent&lt;br&gt;tag: absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Promote run 2&lt;/b&gt;, same build 4101&lt;br&gt;(or Re-run all jobs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;server&lt;/b&gt;: check-publish; deploy skipped:&lt;br&gt;the server already runs this commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="95" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;publish&lt;/b&gt;: same files again, no change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="250" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;mirror&lt;/b&gt;, &lt;b&gt;addon-release&lt;/b&gt;, &lt;b&gt;tag&lt;/b&gt; run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="195" width="250" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="0.2.5 fully released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1230" y="190" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="run again with 4101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;" edge="1" parent="1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="Running promote a third time passes every job and changes nothing." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="255" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="Possible for 30 days, while build 4101's artifacts exist." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="B. A new build for a version that is already partly released" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;Release build&lt;/b&gt; on main,&lt;br&gt;version still 0.2.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;guard&lt;/b&gt; refuses:&lt;br&gt;0.2.5 is already partly released.&lt;br&gt;Run Release promote with build run 4101." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="290" y="395" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n19" target="n20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="If 4101 already finished it, or its artifacts expired,&lt;br&gt;the message asks for a new version: release PR 0.2.6." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="475" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="C. A build run fails" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="860" y="350" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;Release build&lt;/b&gt; 4102&lt;br&gt;Windows signing flakes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="400" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="Rerun 4102&lt;br&gt;&amp;#8594; guard or verify refuses:&lt;br&gt;build runs are never rerun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1130" y="395" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="Start &lt;b&gt;Release build&lt;/b&gt; 4103" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1400" y="405" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n24" target="n25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e28" value="instead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n24" target="n26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="Nothing was shipped, so nothing is lost." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="480" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="D. Promoting a different build of a version that is partly out" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="570" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="latest.json on OVH is&lt;br&gt;from build &lt;b&gt;4101&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;Release promote&lt;/b&gt;&lt;br&gt;build_run_id = &lt;b&gt;4103&lt;/b&gt;,&lt;br&gt;also 0.2.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="250" y="612" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;guard&lt;/b&gt;: client feed is a &lt;b&gt;conflict&lt;/b&gt;&lt;br&gt;(0.2.5 from another build). Stops before&lt;br&gt;anything changes; you decide." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="480" y="610" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;endArrow=none;" edge="1" parent="1" source="n31" target="n32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n32" target="n33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n36" value="Usual decision: finish with 4101, or prepare 0.2.6.&lt;br&gt;An older build never replaces a newer feed: the&lt;br&gt;OVH helper refuses it as well." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="690" width="310" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n37" value="E. Re-running only the failed jobs of a promote run" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="860" y="570" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;Promote run 5&lt;/b&gt;, attempt 1&lt;br&gt;publish approval rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="615" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;Re-run failed jobs&lt;/b&gt; (attempt 2)&lt;br&gt;publish fails: guard passed in&lt;br&gt;attempt 1, not 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1120" y="610" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;Re-run all jobs&lt;/b&gt; or a new run:&lt;br&gt;guard reads every output again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1390" y="612" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n38" target="n39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" value="instead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n38" target="n40">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="700" />
              <mxPoint x="1515" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n43" value="The production lock is held only while an attempt runs.&lt;br&gt;Between attempts another release or deploy could ship." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="715" width="380" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-4" name="4. Example: hotfixes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Example: hotfixes" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="A. Server-only bug" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Fix PR&lt;/b&gt;&lt;br&gt;+ changes/server-&amp;lt;slug&amp;gt;.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;main&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="115" width="100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Deploy to OVH&lt;/b&gt;&lt;br&gt;check.yml for this SHA, then build,&lt;br&gt;record the digest and deploy it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="105" width="300" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="production" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="99" width="100" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Server fixed. Clients unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="115" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="If a promotion is running, Deploy to OVH waits for it (shared lock).&lt;br&gt;A promotion resumed later skips its server step: the server already&lt;br&gt;runs a newer commit, so the hotfix stays.&lt;br&gt;The change file ships in the next release's changelog." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="185" width="440" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="B. Addon or app bug, main is releasable" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="1640" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;Fix PR&lt;/b&gt;&lt;br&gt;+ changes/addon-&amp;lt;slug&amp;gt;.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;Release PR&lt;/b&gt;&lt;br&gt;prepare-release 0.2.6, label release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n13" target="n14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;make release&lt;/b&gt;&lt;br&gt;Release build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n14" target="n16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;Release promote&lt;/b&gt;&lt;br&gt;after you confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="820" y="330" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n16" target="n18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="0.2.6 shipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="330" width="210" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n18" target="n20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="A patch bump: fixes only. New features bump the minor number." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="420" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="C. Bug while main holds visible unfinished work" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="460" width="1640" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="main has a half-done feature&lt;br&gt;that players would see" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="525" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;Switch its flag off&lt;/b&gt;&lt;br&gt;or revert it (PR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="320" y="505" width="220" height="55" as="geometry" />
