          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;#26&lt;/b&gt; another agent PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1290" y="250" width="170" height="30" as="geometry" />
