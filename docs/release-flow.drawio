        </mxCell>
        <mxCell id="n65" value="&lt;b&gt;Deploy to OVH&lt;/b&gt; (server-only hotfix)&lt;br&gt;runs check.yml, then builds and deploys that image's digest.&lt;br&gt;Shares the lock &lt;i&gt;goldbook-production&lt;/i&gt; with promote,&lt;br&gt;so the two never interleave." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="690" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e66" value="server-only fix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="n9" target="n65">
