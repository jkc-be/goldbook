        <mxCell id="n36" value="Release promote (Actions, input: build run ID)" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;fillColor=#f6fbf5;" vertex="1" parent="1">
