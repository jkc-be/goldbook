          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n53" value="Promote builds nothing. To finish a release that stopped,&lt;br&gt;start a new run with the same build run ID or use&lt;br&gt;&lt;b&gt;Re-run all jobs&lt;/b&gt;. &lt;b&gt;Re-run failed jobs&lt;/b&gt; is refused:&lt;br&gt;it would skip guard." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="595" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n54" value="What users get" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;fillColor=#faf6fc;" vertex="1" parent="1">
          <mxGeometry x="1370" y="100" width="300" height="560" as="geometry" />
