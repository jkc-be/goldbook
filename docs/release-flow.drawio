        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n24" target="n26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;#26&lt;/b&gt; merged before the build started.&lt;br&gt;It does not block or join 0.2.5: the build&lt;br&gt;takes abc123, and #26's change file&lt;br&gt;waits for 0.2.6." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1470" y="220" width="210" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="What players see in 0.2.5:&lt;br&gt;&amp;#8226; Mail search (addon)&lt;br&gt;&amp;#8226; Faster price export (server)&lt;br&gt;Nothing of the accounting export: its flag is off,&lt;br&gt;so parts 1 and 2 ship as dormant code." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="When the export is done, a later PR switches the flag on&lt;br&gt;and adds changes/addon-accounting-export.md.&lt;br&gt;It reaches players in the next release." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="330" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
