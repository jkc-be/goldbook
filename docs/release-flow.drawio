        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;Build run ID&lt;/b&gt;&lt;br&gt;installers, feed, addon, image digest&lt;br&gt;kept 30 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="575" width="260" height="55" as="geometry" />
