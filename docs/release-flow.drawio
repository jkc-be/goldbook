        <mxCell id="n10" value="&lt;b&gt;#21 Mail search&lt;/b&gt; (agent 1)&lt;br&gt;+ changes/addon-mail-search.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
