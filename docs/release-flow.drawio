        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;#25 Release PR&lt;/b&gt;, label release&lt;br&gt;make prepare-release VERSION=0.2.5&lt;br&gt;CHANGELOG.md gets&lt;br&gt;## 0.2.5: Addon, Server sections&lt;br&gt;both change files deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
