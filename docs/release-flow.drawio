<mxfile host="Electron" type="device">
  <diagram id="page-1" name="1. Overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="How a Goldbook release works" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Merging to &lt;b&gt;main&lt;/b&gt; ships nothing. &lt;b&gt;make release&lt;/b&gt; runs a release as two workflows: &lt;b&gt;Release build&lt;/b&gt; makes and checks every artifact once for the chosen commit, &lt;b&gt;Release promote&lt;/b&gt; ships exactly those artifacts after you confirm. Only jkc-be starts them and approves." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Develop (many agents in parallel)" style="swimlane;horizontal=1;startSize=28;html=1;rounded=1;arcSize=4;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="300" height="560" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Agent PR&lt;/b&gt;: a feature&lt;br&gt;+ changes/addon-&amp;lt;slug&amp;gt;.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Agent PR&lt;/b&gt;: unfinished work&lt;br&gt;unwired or behind a flag that is off&lt;br&gt;label &lt;i&gt;no-changes&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;Agent PR&lt;/b&gt;: a server change&lt;br&gt;+ changes/server-&amp;lt;slug&amp;gt;.md&lt;br&gt;compatible with fixtures/clients/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="295" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Every PR is safe to release on its own.&lt;br&gt;Required checks: test, desktop-tests,&lt;br&gt;local-stack, secrets, changes.&lt;br&gt;You review and merge." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="375" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Release PR&lt;/b&gt; (an agent may prepare it)&lt;br&gt;make prepare-release VERSION=x.y.z&lt;br&gt;changes/* &amp;#8594; CHANGELOG.md&lt;br&gt;bumps every version field&lt;br&gt;label &lt;i&gt;release&lt;/i&gt;; nothing else allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;main&lt;/b&gt;&lt;br&gt;always releasable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n9">
          <mxGeometry relative="1" as="geometry" />
