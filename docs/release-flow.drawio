        <mxCell id="n37" value="&lt;b&gt;guard&lt;/b&gt;&lt;br&gt;build run is a green first attempt;&lt;br&gt;every output absent or matches this build;&lt;br&gt;records its attempt for the jobs below" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="970" y="130" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n38" value="&lt;b&gt;server&lt;/b&gt;&lt;br&gt;check-publish, then deploy the build's&lt;br&gt;image digest (backup first); skipped when&lt;br&gt;the server already runs it or newer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="970" y="212" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;installers, then latest.json, then addon.json;&lt;br&gt;helper refuses an older feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="970" y="302" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;mirror&lt;/b&gt;&lt;br&gt;addon/ &amp;#8594; jkc-be/goldbook-addon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="970" y="375" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n41" value="&lt;b&gt;addon-release&lt;/b&gt;&lt;br&gt;waits for Package addon release&lt;br&gt;in goldbook-addon (max 120 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="970" y="450" width="240" height="60" as="geometry" />
