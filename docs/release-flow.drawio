        <mxCell id="n12" value="&lt;b&gt;#23 Accounting export, part 2&lt;/b&gt; (agent 2)&lt;br&gt;still behind the flag&lt;br&gt;label no-changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="440" y="175" width="230" height="60" as="geometry" />
