        <mxCell id="n26" value="then as in B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="600" y="505" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;Release branch&lt;/b&gt; release/0.2&lt;br&gt;from the last tag + cherry-pick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="600" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="Not set up yet. Needs branch policies, job conditions and&lt;br&gt;the helper's head_branch check to allow release/*. Add it the first time it is needed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="605" width="450" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e29" value="usual" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n24" target="n25">
