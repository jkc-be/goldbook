{
  "about": "Open website and the Gold view post the Battle.net session from a one-use page on 127.0.0.1, and expect a session and a redirect to the view.",
  "source": "desktop/src-tauri/src/website.rs:112",
  "request": {
    "method": "POST",
    "path": "/api/desktop-login?view=gold",
    "headers": {
      "Origin": "http://127.0.0.1:49152",
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "session={{battlenet_session}}"
  },
  "expect": {
    "status": 303,
    "headers": {
      "set-cookie": "goldbook_session=[^;]+;.*",
      "location": ".*#gold"
    }
  }
}
